# Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/69696969696969

# Bot token (required)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optionally set default guild and user IDs so you can run without CLI args
DEFAULT_GUILD_ID=69696969696969
DEFAULT_TARGET_USER_ID=69696969696969

# Optional: default channel to send mention into
DEFAULT_CHANNEL_ID=69696969696969

# Optional: default message
DEFAULT_MESSAGE=Hello World

# USER ID to mention if no target user ID is provided
TARGET_USER_ID=69696969696969
DEFAULT_TARGET_USER_ID=69696969696969